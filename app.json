{
  "expo": {
    "name": "PawNotes",
    "slug": "pawnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F0",
    "splash": {
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PawNotes uses your photos so you can add a picture of your pet."
        }
      ],
      "expo-sharing"
    ]
  }
}
